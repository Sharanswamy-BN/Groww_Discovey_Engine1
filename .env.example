# Neon Postgres connection string (Dashboard → Connect)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY="gsk_..."

# Optional: override models if Groq changes IDs
GROQ_FAST_MODEL="openai/gpt-oss-20b"
GROQ_SMART_MODEL="openai/gpt-oss-120b"

# Optional: YouTube Data API v3 for comments on personal-finance videos
YOUTUBE_API_KEY=""
